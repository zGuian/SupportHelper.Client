@inject IMachineServices _services;
@inject IDialogService _dialog;
@inject NavigationManager _navigation;
@inject ISnackbar _snackbar;
@page "/operation"

<style>
    .apply_blur {
        backdrop-filter: blur(10px);
    }
</style>

<MudTable Items="@Machines" 
          Filter="new Func<MachineDto, bool>(FilterFunc1)" Row>
    <ToolBarContent>
        <MudText Typo="Typo.h6">Maquinas</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Conectada</MudTh>
        <MudTh>Hostname</MudTh>
        <MudTh>Usuario</MudTh>
        <MudTh>Dominio</MudTh>
        <MudTh>Tempo ativo</MudTh>
        <MudTh></MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Connected">@context.IsConnected</MudTd>
        <MudTd DataLabel="Hostname">@context.Hostname</MudTd>
        <MudTd DataLabel="User">@context.CurrentUsername</MudTd>
        <MudTd DataLabel="Domain">@context.DomainName</MudTd>
        <MudTd DataLabel="UpTime">@context.UpTime</MudTd>
        <MudTd DataLabel="Detalhes">
            <MudButton OnClick="((e) => OpenDialogNetworkAsync(context.NetworkBoards))" 
                        Size="Size.Small" 
                        Variant="Variant.Filled"
                        StartIcon="@Icons.Material.Filled.Source">
                Detalhes
            </MudButton>
        </MudTd>
        <MudTd>
            <MudButton OnClick="((e) => OpenDialogCommandAsync(context.Hostname))"
                        Size="Size.Small" 
                        Variant="Variant.Filled" 
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Monitor">
                Comando
            </MudButton>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    #region Table
    private IEnumerable<MachineDto>? Machines = [];
    private string searchString1 = "";

    protected override async Task OnInitializedAsync()
    {
        var response = await _services.RequestOnlyMachineAsync("SIDT0022A0D20");
        if (!response.IsSuccess)
        {
            _snackbar.Add(response.Message, Severity.Error);
        }
        var machines = new List<MachineDto>();
        machines.Add(response.Data);
        Machines = machines;
    }

    private bool FilterFunc1(MachineDto element) => FilterFunc(element, searchString1);

    private bool FilterFunc(MachineDto machine, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (machine.Hostname.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (machine.DomainName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }
    #endregion Table

    #region OpenNetwork
    private async Task OpenDialogNetworkAsync(IEnumerable<NetworkBoard> networkBoards)
    {
        var parameters = new DialogParameters<InfoNetworkDialog>
        {
            { x => x.NetworkBoards, networkBoards }
        };

        var options = new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            FullScreen = false,
            Position = DialogPosition.Center,
            CloseButton = false,
            BackdropClick = false,
            BackgroundClass = "apply_blur"
        };
        await _dialog.ShowAsync<InfoNetworkDialog>("Informações de Rede", parameters, options);
    }
    #endregion OpenNetwork

    #region OpenCommand
    bool _request = false;
    private async Task OpenDialogCommandAsync(string id)
    {
        var parameters = new DialogParameters<CommandDialog>
        {
            { x => x.Id, id }
        };

        var options = new DialogOptions()
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true,
            FullScreen = false,
            Position = DialogPosition.Center,
            CloseButton = false,
            BackdropClick = false,
            BackgroundClass = "apply_blur"
        };
        await _dialog.ShowAsync<CommandDialog>("Comando", parameters, options);
    }
    #endregion OpenCommand
}